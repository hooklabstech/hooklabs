# Required: Neon PostgreSQL (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required: Neon Auth (server only)
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_URL
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required for protected administrators (server only, comma-separated)
HOOKLABS_ADMIN_EMAILS=admin@example.com

# Required for the daily Vercel Cron index refresh (server only)
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: canonical public application URL
NEXT_PUBLIC_APP_URL=https://hooklabs.example.com

# Optional: custom Next.js production port on a VPS
PORT=3000

# Notes:
# - Blockchain inspection uses the public RPC URLs defined in lib/blockchain.ts.
# - VERCEL_OIDC_TOKEN and VERCEL_WEB_ANALYTICS_ID are supplied by Vercel when applicable.
# - Do not place secrets in NEXT_PUBLIC_* variables.
